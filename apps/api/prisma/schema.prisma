// This is your Prisma schema file
// Keep the model names as specified

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  clients      Client[]
  estimates    Estimate[]
  jobs         Job[]
  appointments Appointment[]
  invoices     Invoice[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String   // Hashed password for authentication
  companyId String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Client {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  email           String?  @unique // Unique for client portal login
  password        String? // Hashed password for client portal (optional)
  phone           String?
  address         String?
  hasPortalAccess Boolean  @default(false) // Can this client log in?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  estimates   Estimate[]
  jobs        Job[]
  appointments Appointment[]
  invoices    Invoice[]
}

model Estimate {
  id          String   @id @default(cuid())
  companyId   String
  clientId    String
  title       String
  description String?
  amount      Float
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  jobs    Job[]
}

model Job {
  id          String   @id @default(cuid())
  companyId   String
  clientId    String
  estimateId  String?
  title       String
  description String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  estimate     Estimate?     @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  invoices     Invoice[]
}

model Appointment {
  id            String    @id @default(cuid())
  companyId     String
  jobId         String?
  clientId      String?
  title         String
  description   String?
  startTime     DateTime
  endTime       DateTime
  recurrenceRule String? // RFC5545 string
  createdAt     DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job     Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  client  Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
}

model Invoice {
  id            String    @id @default(cuid())
  companyId     String
  jobId         String?
  clientId      String
  invoiceNumber String    @unique
  amount        Float
  status        String    @default("pending")
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job     Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

