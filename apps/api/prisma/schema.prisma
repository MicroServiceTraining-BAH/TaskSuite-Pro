// This is your Prisma schema file
// Keep the model names as specified

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                  User[]
  clients                Client[]
  estimates              Estimate[]
  jobs                   Job[]
  appointments           Appointment[]
  invoices               Invoice[]
  estimateTemplates      EstimateTemplate[]
  invoiceTemplates       InvoiceTemplate[]
  expenses               Expense[]
  bills                  Bill[]
  accounts               Account[]
  invoiceLineItems       InvoiceLineItem[]
  estimateLineItems      EstimateLineItem[]
  timeEntries            TimeEntry[]
  taxRates               TaxRate[]
  serviceTypes           ServiceType[]
  payments               Payment[]
  jobPhotos              JobPhoto[]
  cleaningChecklistItems CleaningChecklistItem[]
  flooringMaterials      FlooringMaterial[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String // Hashed password for authentication
  companyId String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]
}

model Client {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  email           String?  @unique // Unique for client portal login
  password        String? // Hashed password for client portal (optional)
  phone           String?
  address         String?
  hasPortalAccess Boolean  @default(false) // Can this client log in?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  estimates    Estimate[]
  jobs         Job[]
  appointments Appointment[]
  invoices     Invoice[]
}

model Estimate {
  id           String   @id @default(cuid())
  companyId    String
  clientId     String
  title        String
  description  String?
  amount       Float // Calculated from line items
  taxRate      Float    @default(0) // Overall tax rate if not per-item
  status       String   @default("draft")
  estimateType  String? // "cleaning" or "flooring"
  serviceTypeId String?  // Optional reference to custom ServiceType
  metadata      Json? // Builder-specific data (rooms, addons, materials, etc.)
  publicToken  String?  @unique // Public token for viewing/approving without login
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceType ServiceType?        @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)
  jobs        Job[]
  lineItems   EstimateLineItem[]
}

model Job {
  id             String   @id @default(cuid())
  companyId      String
  clientId       String
  estimateId     String?
  title          String
  description    String?
  status         String   @default("pending")
  jobType        String? // "cleaning" or "flooring"
  isRecurring    Boolean  @default(false)
  recurrenceRule String? // RFC5545 string (e.g., "FREQ=WEEKLY;COUNT=4")
  parentJobId    String? // For recurring jobs, links to the original job
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company           Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client            Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  estimate          Estimate?               @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  parentJob         Job?                    @relation("RecurringJobs", fields: [parentJobId], references: [id], onDelete: SetNull)
  recurringJobs    Job[]                   @relation("RecurringJobs")
  appointments      Appointment[]
  invoices          Invoice[]
  timeEntries       TimeEntry[]
  photos            JobPhoto[]
  cleaningChecklist CleaningChecklistItem[]
  flooringMaterials FlooringMaterial[]
}

model Appointment {
  id             String   @id @default(cuid())
  companyId      String
  jobId          String?
  clientId       String?
  title          String
  description    String?
  startTime      DateTime
  endTime        DateTime
  recurrenceRule String? // RFC5545 string
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job     Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  client  Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
}

model Invoice {
  id            String    @id @default(cuid())
  companyId     String
  jobId         String?
  clientId      String
  invoiceNumber String    @unique
  amount        Float // Calculated from line items
  taxRate       Float     @default(0) // Overall tax rate if not per-item
  status        String    @default("pending")
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job       Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  client    Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lineItems InvoiceLineItem[]
  payments  Payment[]
}

model EstimateTemplate {
  id          String   @id @default(cuid())
  companyId   String
  name        String // Template name for easy identification
  title       String
  description String?
  amount      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model InvoiceTemplate {
  id            String   @id @default(cuid())
  companyId     String
  name          String // Template name for easy identification
  invoiceNumber String? // Optional prefix/pattern
  amount        Float
  dueDateDays   Int? // Number of days from creation to due date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model ServiceType {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  description  String?
  pricingItems Json?    // Array of {id, name, price}
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  estimates Estimate[]
}

// Chart of Accounts - Categorize income and expenses
model Account {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  type        String // "income", "expense", "asset", "liability", "equity"
  code        String? // Account code/number (e.g., "4000", "5000")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses Expense[]
  bills    Bill[]
}

// Sales Tax Rates - Manage tax rates for different jurisdictions
model TaxRate {
  id          String   @id @default(cuid())
  companyId   String
  name        String // e.g., "Sales Tax", "GST", "VAT"
  rate        Float // e.g., 0.08 for 8%
  description String?
  isDefault   Boolean  @default(false) // Default tax rate for the company
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// Expense Tracking - Track business expenses
model Expense {
  id            String   @id @default(cuid())
  companyId     String
  accountId     String? // Category from chart of accounts
  vendor        String? // Vendor/supplier name
  description   String
  amount        Float
  date          DateTime @default(now())
  paymentMethod String? // "cash", "check", "credit_card", "bank_transfer"
  receiptUrl    String? // URL to receipt image/document
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
}

// Bill Management - Track bills/vendor invoices you need to pay
model Bill {
  id            String    @id @default(cuid())
  companyId     String
  accountId     String? // Expense category
  vendor        String // Vendor name
  billNumber    String? // Vendor's invoice number
  description   String?
  amount        Float
  dueDate       DateTime
  status        String    @default("unpaid") // "unpaid", "paid", "overdue"
  paidAt        DateTime?
  paymentMethod String? // How it was paid
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
}

// Invoice Line Items - Support multiple items per invoice
model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  companyId   String
  description String
  quantity    Float    @default(1)
  unitPrice   Float
  taxRate     Float    @default(0) // Sales tax rate (e.g., 0.08 for 8%)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// Estimate Line Items - Support multiple items per estimate
model EstimateLineItem {
  id          String   @id @default(cuid())
  estimateId  String
  companyId   String
  description String
  quantity    Float    @default(1)
  unitPrice   Float
  taxRate     Float    @default(0) // Sales tax rate
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([estimateId])
}

// Time Tracking - Track time spent on jobs
model TimeEntry {
  id          String   @id @default(cuid())
  companyId   String
  jobId       String
  userId      String // User who logged the time
  description String?
  hours       Float // Hours worked (e.g., 2.5 for 2 hours 30 minutes)
  date        DateTime @default(now())
  billable    Boolean  @default(true) // Is this time billable to the client?
  rate        Float? // Hourly rate for this entry (optional, can use default)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([userId])
  @@index([date])
}

// Payment Processing - Track payments for invoices
model Payment {
  id              String    @id @default(cuid())
  companyId       String
  invoiceId       String
  amount          Float
  status          String    @default("pending") // "pending", "completed", "failed", "refunded"
  paymentMethod   String // "stripe", "paypal", "cash", "check", "bank_transfer"
  paymentIntentId String? // Stripe payment intent ID
  transactionId   String? // External transaction ID
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([paymentIntentId])
}

// Job Photos - Before/after photos for jobs
model JobPhoto {
  id          String   @id @default(cuid())
  jobId       String
  companyId   String
  url         String // URL to the photo
  photoType   String   @default("general") // "before", "after", "general", "damage", "progress"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

// Cleaning Checklist Items - Room-by-room checklist for cleaning jobs
model CleaningChecklistItem {
  id          String    @id @default(cuid())
  jobId       String
  companyId   String
  room        String // "bedroom", "bathroom", "kitchen", "living_room", etc.
  task        String // "vacuum", "mop", "dust", "clean_windows", etc.
  completed   Boolean   @default(false)
  notes       String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

// Flooring Materials - Material tracking for flooring jobs
model FlooringMaterial {
  id           String   @id @default(cuid())
  jobId        String
  companyId    String
  materialType String // "hardwood", "vinyl", "carpet", "tile", "baseboard", "adhesive", "underlayment"
  name         String // Product name
  quantity     Float
  unit         String // "sqft", "linear_ft", "box", "gallon", etc.
  unitPrice    Float
  wastePercent Float    @default(0) // Waste percentage for calculations
  totalCost    Float // Calculated: quantity * unitPrice * (1 + wastePercent)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([jobId])
}
